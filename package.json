{
  "name": "ssd-drive-sync",
  "productName": "SSD Drive Sync",
  "version": "1.1.0",
  "description": "Détecte les SSD branchés et remplit le Google Sheets des disques.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test:faux": "electron . --faux-ssd",
    "test:securite": "node test/securite.js",
    "test:farfelu": "node test/farfelu.js",
    "secrets": "node scripts/write-secrets.js",
    "dist": "electron-builder --publish never",
    "icone": "electron scripts/icone.js"
  },
  "build": {
    "appId": "com.fantasmagorie.ssddrivesync",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "secrets.json",
      "build/logo.svg",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "SSD Drive Sync"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "directories": {
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "dmg": {
      "title": "SSD Drive Sync",
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
